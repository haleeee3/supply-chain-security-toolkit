# =============================================================
# Python PoC 재현용 표준 Dockerfile 템플릿
#
# 사용법:
#   1) src/requirements.txt 에 취약 버전을 정확히 pin
#   2) src/app/ 에 PoC가 요구하는 최소 앱 코드를 넣는다
#   3) 빌드: docker build -t poc-{CVE-ID} .
#   4) 실행: run.sh (격리 네트워크)를 통해서만 실행
#
# ⚠️ 실행 전 반드시 src/ 안의 코드를 사람이 직접 읽고 검토할 것.
#    (pickle, yaml.load, eval 등 코드 실행형 PoC는 특히 주의)
# =============================================================

ARG PYTHON_VERSION=3.10
FROM python:${PYTHON_VERSION}-slim

ARG CVE_ID=CVE-YYYY-NNNNN
ARG VULNERABLE_PACKAGE=package-name
ARG VULNERABLE_VERSION=0.0.0
LABEL cve="${CVE_ID}" \
      vulnerable_package="${VULNERABLE_PACKAGE}" \
      vulnerable_version="${VULNERABLE_VERSION}"

WORKDIR /app

COPY src/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/app ./app

# ---- 최소 권한 실행 계정 ----
RUN useradd -m -u 10001 pocuser
USER pocuser

# ---- 기본 실행 커맨드 (CVE별로 override) ----
CMD ["python", "app/main.py"]
